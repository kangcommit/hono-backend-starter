{
	"name": "hono-backend-template",
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@11.17.0",
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=11.0.0"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"clean": "rm -rf dist",
		"build": "tsc",
		"start": "node dist/index.js",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:studio": "prisma studio",
		"db:seed": "tsx prisma/seed.ts",
		"db:format": "prisma format",
		"db:validate": "prisma validate",
		"test": "vitest",
		"test:unit": "vitest run",
		"test:integration": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts",
		"test:all": "pnpm test:unit && pnpm test:integration",
		"test:unit:coverage": "vitest run --coverage",
		"test:integration:coverage": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts --coverage",
		"test:coverage": "pnpm test:unit:coverage && pnpm test:integration:coverage",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check": "pnpm lint && pnpm typecheck && pnpm test:all",
		"check:staged": "biome check --staged --no-errors-on-unmatched",
		"prepare": "husky || true"
	},
	"lint-staged": {
		"*.{ts,json,jsonc}": [
			"biome check --write"
		]
	},
	"dependencies": {
		"@hono/node-server": "^2.1.0",
		"@hono/zod-openapi": "^1.5.2",
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@scalar/hono-api-reference": "^0.11.13",
		"better-auth": "^1.6.26",
		"dotenv": "^17.4.2",
		"hono": "^4.13.1",
		"pg": "^8.22.0",
		"pino": "^10.3.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/node": "^26.2.0",
		"@types/pg": "^8.21.0",
		"@vitest/coverage-v8": "^4.1.10",
		"dotenv-cli": "^11.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"pino-pretty": "^13.1.3",
		"prisma": "^7.9.1",
		"tsx": "^4.23.11",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
